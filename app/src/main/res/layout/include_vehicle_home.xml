<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vehicle_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="8dp"
    android:paddingEnd="18dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/zontes_bt"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_bt_chip"
            android:contentDescription="@string/zontes_bt_desc"
            android:padding="12dp"
            android:src="@drawable/ic_bluetooth" />

        <TextView
            android:id="@+id/zontes_voltage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/zontes_voltage_empty"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/zontes_more"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingHorizontal="12dp"
            android:text="@string/zontes_more"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/zontes_hero"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/app_full_name"
        android:scaleType="fitCenter"
        android:src="@drawable/zontes_hero" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/zontes_lock"
            style="@style/ZontesAction"
            android:layout_marginEnd="8dp"
            android:text="@string/zontes_lock" />

        <TextView
            android:id="@+id/zontes_unlock"
            style="@style/ZontesAction"
            android:layout_marginStart="8dp"
            android:text="@string/zontes_unlock" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/zontes_fuel"
            style="@style/ZontesAction"
            android:layout_marginEnd="8dp"
            android:text="@string/zontes_fuel" />

        <TextView
            android:id="@+id/zontes_seat"
            style="@style/ZontesAction"
            android:layout_marginStart="8dp"
            android:text="@string/zontes_seat" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_screen_mirror"
        style="@style/ZontesAction.Wide"
        android:layout_marginTop="12dp"
        android:text="@string/zontes_mirror" />

    <TextView
        android:id="@+id/zontes_renew"
        style="@style/ZontesAction.Wide"
        android:layout_marginTop="12dp"
        android:text="@string/zontes_renew" />

    <TextView
        android:id="@+id/zontes_dashcam"
        style="@style/ZontesAction.Wide"
        android:layout_marginTop="12dp"
        android:text="@string/zontes_dashcam" />
</LinearLayout>
