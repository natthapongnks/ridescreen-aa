<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vehicle_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_vignette">

    <ImageView
        android:id="@+id/zontes_hero"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_full_name"
        android:scaleType="centerCrop"
        android:src="@drawable/zontes_hero" />

    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_hero_fade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:id="@+id/zontes_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/archivo_black"
                android:letterSpacing="0.16"
                android:text="@string/app_name"
                android:textColor="@color/nf_text"
                android:textSize="22sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/zontes_bt"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/zontes_bt_desc"
                android:padding="12dp"
                android:src="@drawable/ic_bluetooth" />

            <TextView
                android:id="@+id/zontes_more"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:gravity="center"
                android:minWidth="72dp"
                android:paddingHorizontal="8dp"
            android:text="@string/zontes_more"
            android:textColor="@color/nf_muted"
            android:textSize="16sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/zontes_voltage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/zontes_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/archivo_black"
            android:letterSpacing="0.04"
            android:text="@string/app_full_name"
            android:textColor="@color/nf_text"
            android:textSize="36sp" />

        <TextView
            android:id="@+id/zontes_conn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/conn_ready"
            android:textColor="@color/nf_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/zontes_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="3"
            android:text="@string/hint_idle"
            android:textColor="@color/nf_muted"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_nf_glow" />

            <TextView
                android:id="@+id/btn_screen_mirror"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nf_cta"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="64dp"
                android:paddingHorizontal="20dp"
                android:text="@string/zontes_mirror"
                android:textColor="@color/nf_text"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
